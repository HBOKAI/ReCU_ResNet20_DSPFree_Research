# Preserve datasets, checkpoints, and historical experiment directories on
# disk without adding them to the new local source-control baseline.
__pycache__/
*.py[cod]
.pytest_cache/
*.pt
*.pth
*.zip
/data/
/logs/
/experiments/*
!/experiments/gmp_ablation/
/ReCU_*_Pack/

# Private credentials and generated model-weight exports are not archives.
.env
.env.*
*.pem
*.key
/reference_inference/params_export/*.npz
/experiments/gmp_ablation/*_smoke/
