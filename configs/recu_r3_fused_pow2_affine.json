  "finetune": {
    "epochs": 100,
    "lr": 0.01,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "tau": 0.99,
    "scheduler": "cosine"
  },
  "output": {
    "root": "experiments/recu_r3_fused_pow2_affine"
  }
}
