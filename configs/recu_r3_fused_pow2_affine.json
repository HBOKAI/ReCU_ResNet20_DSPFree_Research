{
  "experiment": {
    "name": "recu_r3_fused_pow2_affine",
    "mode": "r3",
    "seed": 123
  },
  "dataset": {
    "name": "cifar10",
    "root": "./data",
    "download": true,
    "protocol": "official_recu_train_test"
  },
  "training": {
    "batch_size": 256,
    "test_batch_size": 128,
    "num_workers": 8,
    "windows_safe_smoke": true
